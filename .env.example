# Copy to .env. Server only: never use a VITE_ prefix for credentials.
# Required for Boson voice (the same key also drives the avatar).
BOSON_API_KEY=
# Exact hackathon preview ID from the opening slides; verified with the team key.
# No automatic fallback to another model.
BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime
# Optional near-real-time whiteboard vision through Vertex AI. Server only.
# Run gcloud auth application-default login as the user running npm run dev.
# No GEMINI_API_KEY is needed. Credentials are not copied into this project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VISION_MODEL=gemini-3.5-flash-lite
# Alternative for the Node voice server only:
# BOSON_API_KEY_FILE=/absolute/path/to/a/key-file

# Required for Boson talking avatar mode. Create a project at cloud.livekit.io;
# copy the project URL and Settings > Keys values. Server only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Default live avatar: use an avatar_id returned by GET /v1/avatars.
# Account-owned custom IDs are supported once Boson registers them for your key.
# If unavailable, the classroom selects a catalog preset and shows a notice.
# Unset/blank prefers an owned avatar when present, otherwise Claire/a preset.
BOSON_AVATAR_ID=builtin_claire_v1
# Optional distinct LIVE avatar IDs for Maya/Kai, returned by GET /v1/avatars.
# Workspace gallery entries a01/a08 and portrait URLs are NOT live avatar IDs.
# Leave blank until Boson supplies catalog IDs; the UI labels fallback faces.
BOSON_MAYA_AVATAR_ID=
BOSON_KAI_AVATAR_ID=

# Optional Node token server overrides. Keep PORT=3000 for the Vite proxy.
PORT=3000
BOSON_BASE_URL=https://api.boson.ai
# Optional override for the tablet QR-link origin. Leave unset to automatically
# prefer the Wi-Fi adapter, then other physical adapters, over virtual adapters.
# PUBLIC_APP_URL=http://<your-wifi-ip>:5173

# Optional path to a Python 3.10+ environment with avatar/requirements.txt installed.
# Defaults to .venv-avatar/Scripts/python.exe on Windows or .venv-avatar/bin/python elsewhere.
# AVATAR_PYTHON=C:\path\to\python.exe
